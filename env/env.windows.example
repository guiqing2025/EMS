# Windows 本机路径模板 —— 复制为 env/local.env 后按需修改（勿提交 local.env）
# Copy-Item env\env.windows.example env\local.env
#
# 请先把「共享-测试软件资料」映射为盘符或 UNC，再改下面路径。

EMS_ROLE=windows_prod
# 留空则启动时自动探测本机局域网 IP；也可写成 http://x.x.x.x:8000
# EMS_PUBLIC_URL=

# 示例：Z: 映射共享根，或直接用 UNC \\server\share
EMS_SHARE_ROOT=Z:\共享-测试软件资料

WAREHOUSE_SHARE_PATH=Z:\共享-测试软件资料\D-仓库表格\客户进销表
ENGINEERING_SHARE_BASE=Z:\共享-测试软件资料\A-生产 工程 品质共用文件夹
HR_ROSTER_PATH=Z:\共享-测试软件资料\B-行政 人事资料\鼎雄员工花名册.xlsx
SUBSTITUTION_FILE_PATH=C:\EMS\data\替代料06-03.xls
PROCESS_DETAIL_FILE_PATH=C:\EMS\data\工艺明细.xlsx
LASER_PRINT_REGISTER_PATH=Z:\共享-测试软件资料\I-表格类\打印条码登记表.xlsx
LASER_IMPORT_DEFAULT_PATH=C:\EMS\data\镭雕记录表.xlsx
